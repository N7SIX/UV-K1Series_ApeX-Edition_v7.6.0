cmake_minimum_required(VERSION 3.22)

set(CMAKE_C_STANDARD 11)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_C_EXTENSIONS ON)


if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE "Debug")
endif()

set(CMAKE_PROJECT_NAME n7six)

# Enable compile command to ease indexing with e.g. clangd
set(CMAKE_EXPORT_COMPILE_COMMANDS TRUE)

project(${CMAKE_PROJECT_NAME})
message("Build type: " ${CMAKE_BUILD_TYPE})

enable_language(C ASM)

find_package(Git QUIET)
set(BUILD_COMMIT "unknown")
if(GIT_FOUND AND EXISTS "${CMAKE_SOURCE_DIR}/.git")
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" rev-parse --short HEAD
        WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}"
        OUTPUT_VARIABLE BUILD_COMMIT
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
    )
    if(NOT BUILD_COMMIT)
        set(BUILD_COMMIT "unknown")
    endif()
endif()
if(BUILD_COMMIT STREQUAL "unknown")
    # Use Python to generate a hex timestamp that looks like a git commit hash
    execute_process(
        COMMAND python -c "import time, sys; sys.stdout.write(format(int(time.time()), '08x'))"
        OUTPUT_VARIABLE BUILD_COMMIT
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
    )
    if(NOT BUILD_COMMIT)
        # If Python fails, fall back to a simple hex timestamp
        string(TIMESTAMP BUILD_COMMIT "%s")
        string(SUBSTRING "${BUILD_COMMIT}" 2 -1 BUILD_COMMIT_SUFFIX)
        set(BUILD_COMMIT "build${BUILD_COMMIT_SUFFIX}")
    endif()
endif()
message("BUILD_COMMIT=${BUILD_COMMIT}")

if(ENABLE_FEAT_N7SIX)
    if(NOT AUTHOR_STRING_1)
        set(AUTHOR_STRING_1 "EGZUMER")
    endif()
    if(NOT AUTHOR_STRING_2)
        set(AUTHOR_STRING_2 "N7SIX")
    endif()
    if(NOT VERSION_STRING_1)
        set(VERSION_STRING_1 "v0.22")
    endif()
    if(NOT VERSION_STRING_2)
        set(VERSION_STRING_2 "v4.2")
    endif()
    if(NOT EDITION_STRING)
        set(EDITION_STRING "Custom")
    endif()
    if(NOT AUTHOR_STRING)
        set(AUTHOR_STRING "${AUTHOR_STRING_1}+${AUTHOR_STRING_2}")
    endif()
    if(NOT VERSION_STRING)
        set(VERSION_STRING ${VERSION_STRING_2})
    endif()
else()
    if(NOT AUTHOR_STRING)
        set(AUTHOR_STRING "EGZUMER")
    endif()
    if(NOT VERSION_STRING)
        set(VERSION_STRING "NOGIT")
    endif()
endif()

if(TARGET)
    set(EXE_NAME ${TARGET})
else()
    set(EXE_NAME "firmware")
endif()

if(NOT FIRMWARE_PACKAGE_NAME)
    if(ENABLE_FEAT_N7SIX)
        set(FIRMWARE_PACKAGE_NAME "n7six.ApeX-k1.${VERSION_STRING_2}")
    else()
        set(FIRMWARE_PACKAGE_NAME "${EXE_NAME}.${VERSION_STRING}")
    endif()
endif()

message("EXE_NAME = " ${EXE_NAME})
message("FIRMWARE_PACKAGE_NAME = " ${FIRMWARE_PACKAGE_NAME})

add_executable(${EXE_NAME})

add_subdirectory(Drivers)
add_subdirectory(Middlewares)
add_subdirectory(Core)
add_subdirectory(App)

target_link_libraries(${EXE_NAME} Core App)

target_compile_definitions(${EXE_NAME} PRIVATE $<$<CONFIG:Debug>:DEBUG>)
target_link_libraries(${EXE_NAME} ${TOOLCHAIN_LINK_LIBRARIES})

if(ENABLE_LTO)
    target_compile_options(${EXE_NAME} PRIVATE -flto=auto)
endif()

if(ENABLE_PA_PROTECTION)
    target_compile_definitions(${EXE_NAME} PRIVATE ENABLE_PA_PROTECTION)
    message("PA protection enabled")
else()
    message("PA protection disabled")
endif()

# Generate map file using the firmware package file name
set_target_properties(${EXE_NAME} PROPERTIES OUTPUT_NAME ${FIRMWARE_PACKAGE_NAME})
target_link_options(${EXE_NAME} PRIVATE "-Wl,-Map=${FIRMWARE_PACKAGE_NAME}.map")

# Add the map file to the list of files to be removed with 'clean' target
set_target_properties(${EXE_NAME} PROPERTIES ADDITIONAL_CLEAN_FILES ${FIRMWARE_PACKAGE_NAME}.map)

# Force linker to ignore RWX segment warning even if cache exists
target_link_options(${EXE_NAME} PRIVATE -Wl,--no-warn-rwx-segment)

# -----------------------------------
#  Post build processing
#

# Generate .bin and .hex files in the build directory using the package filename
add_custom_command(
    TARGET ${EXE_NAME}
    POST_BUILD
    COMMAND ${CMAKE_OBJCOPY} -O binary ${FIRMWARE_PACKAGE_NAME}.elf ${CMAKE_BINARY_DIR}/${FIRMWARE_PACKAGE_NAME}.bin
    COMMAND ${CMAKE_OBJCOPY} -O ihex ${FIRMWARE_PACKAGE_NAME}.elf ${CMAKE_BINARY_DIR}/${FIRMWARE_PACKAGE_NAME}.hex
    COMMENT "Generating firmware outputs in build directory"
)

